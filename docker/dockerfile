########################################################################
# Builder: system build toolchain + Python deps, isolated to this stage
# so none of it ends up in the final image.
########################################################################
FROM public.ecr.aws/docker/library/python:3.11-slim-bookworm AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        g++ \
        zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /usr/src/app/GRAPES2
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

########################################################################
# Runtime: slim image with only what's needed to execute GRAPES2.
########################################################################
FROM public.ecr.aws/docker/library/python:3.11-slim-bookworm

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        bedtools \
        samtools && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv

WORKDIR /usr/src/app/GRAPES2
COPY . .

# Mappability annotation tracks (~680MB for hg19+hg38 combined) are not
# shipped in the image. Supply them at runtime via a volume mount, e.g.:
#   docker run -v /path/to/mappability:/usr/src/app/GRAPES2/annotations/mappability ...
# Populate that host directory once with: python3 install.py
RUN mkdir -p annotations/mappability

ENV PATH="/opt/venv/bin:/usr/src/app/GRAPES2:${PATH}"

# Default command
CMD ["python", "grapes2.py"]
